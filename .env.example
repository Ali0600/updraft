# Copy to .env and fill in. Never commit .env — it is gitignored.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Origin clients reach this server at. Asset URLs inside manifests are built
# from it, so it must be reachable from the device (not "localhost" for a
# physical phone). Physical iOS devices additionally require HTTPS (ATS).
PUBLIC_URL=http://localhost:3000

# Metadata store and blob storage (mounted volumes in Docker).
DB_PATH=./data/db.sqlite
# 'local' keeps blobs on disk; 's3' uses any S3-compatible store
# (AWS, MinIO, Cloudflare R2, Backblaze B2).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/blobs

# Required when STORAGE_DRIVER=s3; the server refuses to boot without it.
# S3_BUCKET=updraft-updates
# S3_REGION=us-east-1

# Set for anything that is not AWS. Path-style addressing switches on
# automatically when an endpoint is present, which is what MinIO and most
# self-hosted gateways need; override with S3_FORCE_PATH_STYLE if not.
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true

# Leave both unset to use the ambient AWS credential chain (IAM role or
# instance profile) — the recommended production path. Setting exactly one is
# a boot error: the chain would silently fall back to ambient credentials and
# write into whatever bucket those happen to reach.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Serve assets from a CDN or the bucket directly instead of proxying them.
# The URL path is the object's storage key, so assets/<sha256> must resolve
# at this origin. Only affects manifests built from now on — the server keeps
# serving assets itself, because deployed devices still ask it to.
# ASSETS_BASE_URL=https://cdn.example.com

# Bearer token for every admin/publish route. Minimum 32 characters.
# Generate with: openssl rand -hex 32
PUBLISH_TOKEN=replace-me-with-openssl-rand-hex-32-output

# Code signing. Generate keys with: updraft keys generate --output ./certs
# The private key is mounted at runtime and never committed.
#
# Supply the key by path OR as inline base64 (for platforms that only offer
# environment variables) — setting both is a configuration error rather than a
# silent precedence rule. Leave both unset to run without signing; clients that
# request a signature then get a 400 rather than an unsigned update.
#
# In Docker the key is mounted read-only at /keys:
# CODE_SIGNING_PRIVATE_KEY_PATH=/keys/private-key.pem
# CODE_SIGNING_PRIVATE_KEY_BASE64=
CODE_SIGNING_KEY_ID=main
