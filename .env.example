# Copy to .env and fill in. Never commit .env — it is gitignored.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Origin clients reach this server at. Asset URLs inside manifests are built
# from it, so it must be reachable from the device (not "localhost" for a
# physical phone). Physical iOS devices additionally require HTTPS (ATS).
PUBLIC_URL=http://localhost:3000

# Metadata store and blob storage (mounted volumes in Docker).
DB_PATH=./data/db.sqlite
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/blobs

# Bearer token for every admin/publish route. Minimum 32 characters.
# Generate with: openssl rand -hex 32
PUBLISH_TOKEN=replace-me-with-openssl-rand-hex-32-output

# Code signing. Generate keys with: updraft keys generate --output ./certs
# The private key is mounted at runtime and never committed.
#
# Supply the key by path OR as inline base64 (for platforms that only offer
# environment variables) — setting both is a configuration error rather than a
# silent precedence rule. Leave both unset to run without signing; clients that
# request a signature then get a 400 rather than an unsigned update.
#
# In Docker the key is mounted read-only at /keys:
# CODE_SIGNING_PRIVATE_KEY_PATH=/keys/private-key.pem
# CODE_SIGNING_PRIVATE_KEY_BASE64=
CODE_SIGNING_KEY_ID=main
