{
  "name": "@ota/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Update server implementing the Expo Updates protocol v1",
  "license": "MIT",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('node:fs').cpSync('src/db/migrations','dist/migrations',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.1",
    "@ota/core": "workspace:*",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "structured-headers": "^2.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3"
  }
}
